---
import type { RaceEvent } from '../lib/types';
import { DEPARTMENT_NAMES, eventUrl } from '../lib/events';
import { dayNumber, formatDay, monthShort, weekdayShort } from '../lib/format';
import StatusBadge from './StatusBadge.astro';
import { effectiveStatus, verifiedRegistrationUrl } from '../lib/status';
import TransportBadge from './TransportBadge.astro';
interface Props { event: RaceEvent; heading?: 'h3' | 'h4'; hidden?: boolean }
const { event, hidden = false } = Astro.props;
const registrationStatus = effectiveStatus(event);
const registrationLink = verifiedRegistrationUrl(event);
---
<li class="event-card" data-event-id={event.id} data-event-date={event.date} id={`e-${event.id}`} hidden={hidden}>
  <div class="event-date" aria-hidden="true">
    {weekdayShort(event.date)}<b>{dayNumber(event.date)}</b>{monthShort(event.date)}
  </div>
  <div>
    <h3><a href={eventUrl(event)}>{event.name}</a></h3>
    <p class="event-meta">
      <span class="sr-only">{formatDay(event.date)} — </span>
      {event.town ?? 'Commune à confirmer'} · {DEPARTMENT_NAMES[event.department]} ({event.department}) · {event.kind}
    </p>
    <p class="small" style="margin:0 0 8px">{event.formats}</p>
    <div class="badges">
      <StatusBadge event={event} />
      <TransportBadge code={event.transport} />
    </div>
    {registrationStatus === 'ouvert' && registrationLink && <p class="small" style="margin:8px 0 0"><a href={registrationLink} rel="noopener">S’inscrire</a></p>}
    {registrationStatus === 'annonce' && event.officialUrl && <p class="small" style="margin:8px 0 0"><a href={event.officialUrl} rel="noopener">Voir l’annonce de l’organisateur</a></p>}
    {event.sourceConflict && <p class="small" style="margin:8px 0 0"><a href={event.sourceConflict.url} rel="noopener">Vérifier les informations contradictoires</a></p>}
  </div>
</li>
