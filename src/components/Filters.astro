---
import { events, DEPARTMENT_NAMES, FORMAT_LABELS, toFilterable } from '../lib/events';
import { formatMonth } from '../lib/format';
import { STATUS_META } from '../lib/status';
import { ACCESS_LABEL } from '../lib/transport';
import { REGISTRATION_STATUSES } from '../lib/schema';

const filterable = events.map(toFilterable);
const uniq = (values: string[]) => [...new Set(values)];
const groups = [
  { key: 'dep', legend: 'Dans quel département ?', options: Object.entries(DEPARTMENT_NAMES).map(([v, l]) => ({ v, l: `${l} (${v})` })) },
  { key: 'kind', legend: 'Quel sport ?', options: uniq(filterable.map((e) => e.kind)).sort((a, b) => a.localeCompare(b, 'fr')).map((v) => ({ v, l: v })) },
  { key: 'format', legend: 'Quelle distance ?', options: Object.entries(FORMAT_LABELS).filter(([v]) => filterable.some((e) => e.formatTags.includes(v))).map(([v, l]) => ({ v, l })) },
  { key: 'month', legend: 'Quand souhaitez-vous courir ?', options: uniq(filterable.map((e) => e.month)).sort().map((v) => ({ v, l: formatMonth(v) })) },
  { key: 'status', legend: 'Où en sont les inscriptions ?', options: REGISTRATION_STATUSES.map((v) => ({ v, l: STATUS_META[v].label })) },
  // Filtre « avec vélo » exigé par le §5 de CLAUDE.md : toujours présent, mais grisé et explicite tant qu'aucune règle n'est confirmée.
  { key: 'access', legend: 'Comment rejoindre la commune depuis Nantes ?', options: Object.entries(ACCESS_LABEL).map(([v, l]) => {
    const none = v === 'velo' && !filterable.some((e) => e.access.includes('velo'));
    return { v, l: none ? `${l} — aucune règle confirmée à ce jour` : l, disabled: none };
  }) },
];
---
<form class="card filters" id="filters" role="search" aria-label="Filtrer les épreuves" onsubmit="return false">
  <div class="field">
    <label for="q">Rechercher une compétition ou une ville</label>
    <input type="search" id="q" name="q" placeholder="Ex. : Vertou, swimrun, Laval…" autocomplete="off" />
  </div>
  <p class="small muted" style="margin:0">Choisissez un ou plusieurs critères. Les résultats s’actualisent automatiquement.</p>
  <label class="chip" style="justify-self:start"><input type="checkbox" name="passees" value="1" /><span>Afficher aussi les épreuves passées</span></label>
  <details id="filter-details">
    <summary>Choisir mes filtres (sport, lieu, date, transports) <span class="badge badge-brand" id="filter-count" hidden></span></summary>
    <p class="small muted" style="margin-top:8px">Par exemple : « Triathlon » + « Vendée » + « septembre ». Plusieurs choix peuvent être combinés.</p>
    <div class="filter-groups">
      {groups.map((g) => (
        <fieldset>
          <legend class="legend">{g.legend}</legend>
          <div class="chips">
            {g.options.map((o) => (
              <label class="chip"><input type="checkbox" name={g.key} value={o.v} disabled={(o as { disabled?: boolean }).disabled ?? false} /><span>{o.l}</span></label>
            ))}
          </div>
        </fieldset>
      ))}
    </div>
    <p class="small muted" style="margin:12px 0 0">
      Le transport indiqué concerne l’accès à la commune, pas forcément le départ. Le filtre « vélo accepté à bord » s’activera dès qu’une règle vélo sera confirmée pour le jour d’une course.
    </p>
  </details>
  <div class="actions">
    <button type="reset" class="btn btn-secondary" id="filters-reset">Effacer les filtres</button>
    <button type="button" class="btn btn-secondary" id="share-url">Partager les résultats</button>
    <slot />
  </div>
  <p class="sr-only" role="status" aria-live="polite" id="share-feedback"></p>
</form>
<script type="application/json" id="events-data" set:html={JSON.stringify(filterable)} />
