---
import Base from '../../layouts/Base.astro';
import { events, surveys, computeKpis, eventUrl, groupSchedule } from '../../lib/events';
import { formatParis } from '../../lib/format';
import { CATEGORY_LABEL, STATUS_META } from '../../lib/status';
import { REGISTRATION_STATUSES } from '../../lib/schema';

const kpis = computeKpis(events);
const latest = surveys[0];
const find = (id: string) => events.find((e) => e.id === id);
const uniqueChanges = (changes: typeof surveys[number]['changes']) => changes.filter((change, index, all) => {
  const e = find(change.eventId);
  return !e || all.findIndex(other => find(other.eventId)?.eventGroupId === e.eventGroupId) === index;
});
// Le lien « S’inscrire » ne figure que sur l'information la plus récente d'une épreuve ;
// les relevés plus anciens renvoient à leur propre source.
const latestChange = new Map<string, string>();
for (const s of surveys) for (const c of s.changes) if (!latestChange.has(c.eventId)) latestChange.set(c.eventId, s.id);
---
<Base title="Veille des inscriptions" description="Suivi des inscriptions : ce qui est ouvert, annoncé, complet ou encore à confirmer, avec sources et dates de vérification.">
  <section class="section wrap">
    <p class="eyebrow">Journal des relevés</p>
    <h1 style="font-size:clamp(2.2rem,6vw,3.6rem)">Veille des inscriptions</h1>
    <p class="lead">Pour chaque compétition, découvrez si les inscriptions sont ouvertes, annoncées, complètes ou encore à vérifier. Les informations publiées comportent une source et une date.</p>
    <div class="card" style="margin-block:18px">
      <p class="eyebrow">Dernier contrôle</p>
      <p style="font-family:var(--display);font-size:1.8rem;margin:0" id="last-check">
        {latest ? <time datetime={latest.checkedAt}>{formatParis(latest.checkedAt, latest.checkedAtPrecision)}</time> : 'Aucun relevé'}
      </p>
      <p class="small muted" style="margin:6px 0 0">Relevé automatique des pages officielles chaque matin, contrôle des liens publiés chaque jour à 8 h 30. Dernière information publiée : {latest ? formatParis(latest.checkedAt, latest.checkedAtPrecision) : '—'}.</p>
    </div>

    <h2>État actuel</h2>
    <div class="card" style="overflow-x:auto">
      <table class="plain">
        <thead><tr><th scope="col">Statut</th><th scope="col">Journées</th><th scope="col">Signification</th></tr></thead>
        <tbody>
          {REGISTRATION_STATUSES.map((s) => (
            <tr><th scope="row" style="font-family:var(--text);text-transform:none;letter-spacing:0;font-size:1rem;color:var(--ink)">{STATUS_META[s].label}</th>
              <td><a href={`/calendrier/?status=${s}`}>{kpis.byStatus[s]}</a></td><td class="small">{STATUS_META[s].description}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted" style="margin-top:8px">L’absence de page d’inscription ne permet jamais de conclure « fermé » : la fiche reste « non vérifiée ».</p>

    <h2 style="margin-top:32px">Dernières informations par compétition</h2>
    <ol class="timeline" id="timeline">
      {surveys.map((s) => (
        <li class="card">
          <p class="small muted" style="margin:0 0 4px"><time datetime={s.checkedAt}>{formatParis(s.checkedAt, s.checkedAtPrecision)}</time> · {s.kind === 'initial' ? 'Relevé initial' : s.kind === 'correction' ? 'Correction manuelle' : s.kind === 'quotidien' ? 'Relevé quotidien' : 'Relevé hebdomadaire'}</p>
          <h3>{s.title}</h3>
          {s.summary && <p>{s.summary}</p>}
          {s.changes.length === 0
            ? <p class="muted" style="margin:0">Aucune différence avec le relevé précédent{s.kind === 'initial' ? ' (premier relevé)' : ''}.</p>
            : (
              <ul>
                {uniqueChanges(s.changes).map((c) => {
                  const ev = find(c.eventId);
                  return (
                    <li>
                      <strong>{ev ? <a href={eventUrl(ev)}>{ev.name}</a> : c.eventId}</strong>
                      {ev && <div class="small muted">{ev.town ?? 'Lieu à confirmer'} · {groupSchedule(ev)}</div>}
                      <div><span class="badge">{CATEGORY_LABEL[c.category]}</span> {c.summary}</div>
                      {c.previous && <span class="small muted">Statut précédent : {c.previous}</span>}
                      {c.sourceUrl && (latestChange.get(c.eventId) === s.id
                        ? <p class="small" style="margin:5px 0 0"><a href={ev?.registrationStatus === 'ouvert' && ev.registrationUrl ? ev.registrationUrl : ev?.officialUrl ?? c.sourceUrl} rel="noopener">{ev?.registrationStatus === 'ouvert' && ev.registrationUrl ? 'S’inscrire' : ev?.registrationStatus === 'annonce' ? 'Voir l’annonce de l’organisateur' : 'Voir la source officielle'}</a></p>
                        : <p class="small" style="margin:5px 0 0"><a href={c.sourceUrl} rel="noopener">Source de ce relevé</a> <span class="muted">(information depuis remplacée)</span></p>)}
                    </li>
                  );
                })}
              </ul>
            )}
          {s.source && <p class="small" style="margin:8px 0 0">Source : <a href={s.source.url}>{s.source.label}</a></p>}
        </li>
      ))}
    </ol>

    <h2 style="margin-top:32px">Comment les informations sont-elles vérifiées ?</h2>
    <div class="card-sunk">
      <ul style="margin:0;padding-left:18px">
        <li>Chaque matin, une veille automatique lit le calendrier officiel FFTRI et les pages des organisateurs. Elle repère les liens d’inscription 2027, les annonces d’ouverture, les annulations et les changements de date.</li>
        <li>Ce qu’elle repère n’est publié qu’après vérification par un administrateur : une page muette ou introuvable n’est jamais interprétée comme « fermé ».</li>
        <li>Les liens officiels déjà publiés sont en outre contrôlés chaque jour à 8 h 30 (heure de Paris).</li>
        <li>La recherche des ouvertures menée dans ChatGPT reste indépendante du site : ses résultats ne sont pas transmis automatiquement et doivent être validés avant publication.</li>
        <li>Catégories suivies : {Object.values(CATEGORY_LABEL).join(', ').toLowerCase()}.</li>
        <li>Suivre les nouveautés : <a href="/veille/rss.xml">flux RSS</a>.</li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Complète le journal avec les changements validés côté serveur, s'il est disponible.
  interface ApiUpdate { id: number; eventId: string; eventName: string; categoryLabel: string; summary: string; evidence: string | null; sourceUrl: string | null; publishedAt: string }
  const fmt = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Paris' });
  const text = (tag: string, value: string, cls = ''): HTMLElement => Object.assign(document.createElement(tag), { textContent: value, className: cls });
  fetch('/api/updates', { headers: { accept: 'application/json' } })
    .then((r) => (r.ok && r.headers.get('content-type')?.includes('json') ? r.json() : null))
    .then((body: { updates?: ApiUpdate[]; lastCheck?: string | null } | null) => {
      if (!body) return;
      // Dernier contrôle réel (veille automatique ou contrôle des liens), s'il est plus récent que le dernier relevé publié.
      const shown = document.querySelector('#last-check time')?.getAttribute('datetime');
      if (body.lastCheck && (!shown || Date.parse(body.lastCheck) > Date.parse(shown))) {
        document.getElementById('last-check')!.textContent = `${fmt.format(new Date(body.lastCheck))} (heure de Paris)`;
      }
      const list = document.getElementById('timeline')!;
      for (const u of [...(body.updates ?? [])].reverse()) {
        const li = text('li', '', 'card');
        li.append(text('p', `${fmt.format(new Date(u.publishedAt))} (heure de Paris) · Changement validé`, 'small muted'));
        const h = text('h3', `${u.categoryLabel} — `);
        h.append(Object.assign(document.createElement('a'), { href: `/epreuves/${u.eventId}/`, textContent: u.eventName }));
        li.append(h, text('p', u.summary));
        if (u.evidence) li.append(text('p', `Fait vérifié : ${u.evidence}`, 'small'));
        if (u.sourceUrl?.startsWith('https://')) li.append(Object.assign(document.createElement('a'), { href: u.sourceUrl, textContent: u.categoryLabel === 'Ouvert confirmé' ? 'Voir les inscriptions' : u.categoryLabel === 'Ouverture annoncée' ? 'Voir l’annonce de l’organisateur' : 'Voir la source officielle', rel: 'noopener' }));
        list.prepend(li);
      }
    })
    .catch(() => { /* API absente : le journal statique reste affiché */ });
</script>
