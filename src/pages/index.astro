---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { events, surveys, computeKpis, outOfRegion, DEPARTMENT_NAMES, PDF_REFERENCE_DATE } from '../lib/events';
import { formatDay, formatParis } from '../lib/format';
import { CATEGORY_LABEL } from '../lib/status';

const kpis = computeKpis(events);
const latest = surveys[0];
const byId = new Map(events.map(e => [e.id, e]));
const changes = latest?.changes.filter((c, i, all) => {
  const event = byId.get(c.eventId);
  return !event || all.findIndex(other => byId.get(other.eventId)?.eventGroupId === event.eventGroupId) === i;
}) ?? [];
const today = new Date().toISOString().slice(0, 10);
// Quelques épreuves de réserve : le navigateur retire celles passées depuis la publication du site.
const upcoming = events.filter((e) => e.date >= today).slice(0, 12);
const byDep = Object.keys(DEPARTMENT_NAMES).map((d) => ({ d, n: events.filter((e) => e.department === d).length }));
---
<Base title="Triathlon Pays de la Loire 2027">
  <section class="hero wrap">
    <p class="eyebrow">Triathlon Club Nantais · Novembre 2026 → novembre 2027</p>
    <h1>Triathlon <span>Pays de la Loire 2027</span></h1>
    <p class="lead">Toutes les compétitions du calendrier régional de triathlon et disciplines associées : triathlon, duathlon, aquathlon, swimrun et Bike &amp; Run. Retrouvez les dates, les inscriptions et les transports depuis Nantes.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/calendrier/">Voir le calendrier</a>
      <a class="btn btn-dark" href="/carte/">Ouvrir la carte</a>
      <a class="btn btn-secondary" href="/calendrier/#filters">Filtrer les épreuves</a>
      <a class="btn btn-secondary" href="/documents/calendrier-2027.pdf">PDF original</a>
    </div>
    <ul class="kpis" aria-label="Chiffres clés">
      <li class="kpi"><span class="kpi-value" data-kpi="total">{kpis.total}</span><span class="kpi-label">Journées de compétition</span></li>
      <li class="kpi"><span class="kpi-value" data-kpi="open">{kpis.open}</span><span class="kpi-label">Journées avec inscriptions ouvertes</span></li>
      <li class="kpi"><span class="kpi-value" data-kpi="announced">{kpis.announced}</span><span class="kpi-label">Ouvertures annoncées</span></li>
      <li class="kpi"><span class="kpi-value" data-kpi="toConfirm">{kpis.toConfirm}</span><span class="kpi-label">Inscriptions non vérifiées</span></li>
    </ul>
    <p class="small muted" style="margin-top:12px">
      Répartition : {byDep.map((x, i) => <>{i > 0 && ' · '}<a href={`/calendrier/?dep=${x.d}`}>{DEPARTMENT_NAMES[x.d]} {x.n}</a></>)}.
      Une compétition sur plusieurs jours compte une fois par journée. Les {outOfRegion.length} <a href="/hors-region/">rendez-vous hors région</a> sont comptés à part.
    </p>
  </section>

  <section class="section wrap">
    <p class="eyebrow">Veille des inscriptions</p>
    <h2>Dernières informations sur les inscriptions</h2>
    {latest && (
      <article class="card">
        <p class="small muted" style="margin:0 0 4px">Dernière mise à jour publiée : <time datetime={latest.checkedAt}>{formatParis(latest.checkedAt, latest.checkedAtPrecision)}</time></p>
        <h3>{latest.title}</h3>
        <p>{latest.summary}</p>
        {changes.length > 0 ? (
          <ul>
            {changes.slice(0, 6).map((c) => {
              const e = byId.get(c.eventId);
              const days = e ? events.filter(x => x.eventGroupId === e.eventGroupId).map(x => formatDay(x.date)) : [];
              const isOpen = e?.registrationStatus === 'ouvert' && Boolean(e.registrationUrl);
              const link = isOpen ? e?.registrationUrl : (e?.officialUrl ?? c.sourceUrl);
              return <li style="margin-bottom:18px">
                <strong>{e ? <a href={`/epreuves/${e.id}/`}>{e.name}</a> : c.eventId}</strong>
                {e && <div class="small muted">{e.town ?? 'Lieu à confirmer'} · {days.join(' et ')} · {e.formats}</div>}
                <div><span class="badge">{CATEGORY_LABEL[c.category]}</span> {c.summary}</div>
                {link && <p class="small" style="margin:6px 0 0"><a href={link} rel="noopener">{isOpen ? 'S’inscrire' : e?.registrationStatus === 'annonce' ? 'Voir l’annonce de l’organisateur' : 'Consulter la source officielle'}</a></p>}
              </li>;
            })}
          </ul>
        ) : <p class="muted">Aucun changement de statut constaté depuis ce relevé.</p>}
        <div class="actions">
          <a class="btn btn-secondary" href="/veille/">Journal de veille</a>
          {latest.source && <a class="btn btn-secondary" href={latest.source.url}>{latest.source.label}</a>}
        </div>
      </article>
    )}
  </section>

  <section class="section wrap">
    <p class="eyebrow">À venir</p>
    <h2>Prochains rendez-vous</h2>
    <ul class="event-list" id="upcoming-list">{upcoming.map((e, i) => <EventCard event={e} hidden={i >= 4} />)}</ul>
    <p style="margin-top:16px"><a href="/calendrier/">Tous les rendez-vous →</a></p>
  </section>

  <section class="section wrap">
    <div class="notice">
      <p>Dates, formats et itinéraires proviennent du PDF de la Ligue daté du <time datetime={PDF_REFERENCE_DATE}>13 novembre 2026</time>. Rien n’est garanti tant que l’organisateur ou l’opérateur de transport ne l’a pas confirmé : chaque fiche indique ce qui est vérifié et ce qui ne l’est pas.</p>
    </div>
  </section>
</Base>

<script>
  import { parisToday } from '../lib/format';
  // Le site est publié une fois : la date du jour est appliquée à chaque visite.
  const today = parisToday();
  let shown = 0;
  document.querySelectorAll<HTMLElement>('#upcoming-list > [data-event-date]').forEach((li) => {
    const keep = li.dataset.eventDate! >= today && shown < 4;
    li.hidden = !keep;
    if (keep) shown += 1;
  });
</script>
