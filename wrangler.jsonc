{
  // Projet Cloudflare distinct du site Quiberon. Aucun identifiant ni secret dans ce fichier.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcn-calendrier-2027",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Lundi 08:30 Europe/Paris = 07:30 UTC en hiver, 06:30 UTC en été.
  // Les deux déclenchements existent ; le Worker n'exécute que celui qui tombe à 08 h 30 à Paris.
  "triggers": { "crons": ["30 6 * * MON", "30 7 * * MON"] },
  "observability": { "enabled": true },
  // Base D1 dédiée à ce projet (créée le 13/11/2026, schéma worker/schema.sql appliqué).
  // Un identifiant de base n'est pas un secret ; le jeton d'administration, lui, reste un secret Cloudflare.
  "d1_databases": [{ "binding": "DB", "database_name": "tcn-calendrier-2027", "database_id": "aeb5c775-5c52-4321-bffe-4a49a220d0a2" }]
}
